{
  "permissions": {
    "allow": [
      "Read(./**)",               // 读取所有文件
      "Edit(./**)",               // 编辑所有文件
      "Bash(npm *)",              // 所有 npm 命令
      "Bash(git *)",              // 所有 git 命令
      "Bash(ls *)",               // 文件操作
      "Bash(cp *)",               // 复制
      "Bash(mv *)",            // 移动/重命名
      "WebFetch(*)"       // 网络请求前确认
    ],
    "ask": [
      "Bash(rm -rf *)",           // 递归删除前确认
      "Bash(sudo *)"            // sudo 权限前确认      
    ]
  }
}